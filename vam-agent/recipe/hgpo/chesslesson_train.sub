# Chesslesson (Lichess Learn) PPO training on 2x H100.
#
# Submit from login node:
#   mkdir -p $HOME/verl-agent/condor_out/{output,error,log}
#   condor_submit_bid 50 $HOME/verl-agent/recipe/hgpo/chesslesson_train.sub
#
# Monitor:
#   condor_q
#   tail -f condor_out/output/chesslesson_train.*.out
#
# Requires WANDB_API_KEY in the submit environment (export before condor_submit_bid).

universe = vanilla

initialdir = $HOME/verl-agent
executable = /bin/bash

output = condor_out/output/chesslesson_train.$(Cluster).$(Process).out
error  = condor_out/error/chesslesson_train.$(Cluster).$(Process).err
log    = condor_out/log/chesslesson_train.$(Cluster).$(Process).log

request_cpus   = 16
request_memory = 128G
request_gpus   = 2
request_disk   = 100G
requirements   = (TARGET.CUDADeviceName == "NVIDIA H100")

arguments   = $HOME/verl-agent/recipe/hgpo/chesslesson_train_condor.sh
environment = "HOME=$HOME"

queue
