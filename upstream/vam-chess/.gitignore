data/chess_puzzles_select_v3_mixture_curriculum/

# Local W&B evidence / analysis cache (large; not source of truth).
# Keep only final figures + the written markdown summary.
analysis/tmp_download_test*/
analysis/wandb_evidence/**
!analysis/wandb_evidence/**/
!analysis/wandb_evidence/**/guess_analysis/
